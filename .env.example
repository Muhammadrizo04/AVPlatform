SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=av.example.uz
# True faqat nginx (X-Forwarded-For o'rnatadigan) ortida; aks holda mijoz IP'si soxtalashtirilishi mumkin
PROXY_ORQASIDA=False
# True: nginx TLS'ni tugatadi (VPS). Secure cookie, HSTS, X-Forwarded-Proto va CSRF_TRUSTED_ORIGINS yoqiladi
HTTPS=False
# Bo'sh bo'lsa HTTPS=True da ALLOWED_HOSTS dan https://host ko'rinishida olinadi (vergul bilan bir nechta)
# CSRF_TRUSTED_ORIGINS=https://av.example.uz
DATABASE_URL=postgresql://av:parol@localhost:5432/av
ONEC_URL=
ONEC_LOGIN=
ONEC_PAROL=
MEDIA_ROOT=/var/lib/av/media
# Windows dev: WeasyPrint uchun MSYS2 Pango kerak (pacman -S mingw-w64-x86_64-pango); settings_test buni o'zi o'rnatadi
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
