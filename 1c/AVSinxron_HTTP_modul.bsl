// =====================================================================================
// HTTP-servis АВС_AV (kengaytma AVSinxron) — modul TO'LIQ. Kontekst: /hs/av/
// Asosiy vositalar platformasi uchun FAQAT O'QIYDI: faqat so'rovlar, 1C'ga hech qanday yozuv yo'q.
// Xavfsiz rejimda ishlashga mo'ljallangan (привилегированный режим, fayl, COM ishlatilmaydi).
//
// URL shablonlar (Шаблоны URL), hammasi GET:
//   Versiya        : /versiya         -> VersiyaGET
//   Spravochniklar : /spravochniklar  -> SpravochniklarGET
//   Vositalar      : /vositalar       -> VositalarGET
//   Harakatlar     : /harakatlar      -> HarakatlarGET     (?dan=YYYYMMDDhhmmss&gacha=YYYYMMDDhhmmss)
//
// Kontrakt: har "ref" — UUID satr yoki null; sanalar ISO (YYYY-MM-DD, YYYY-MM-DDTHH:MM:SS);
// sonlar JSON number. Xato -> HTTP 400/500 + {"xato": "..."}.
// =====================================================================================

// ===================== METODLAR =====================

Функция VersiyaGET(ВходящийЗапрос)
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("versiya", ВерсияСервиса());
		Данные.Вставить("baza", ИмяБазы());
		Данные.Вставить("server_vaqti", ДатаВремяISO(ТекущаяДата()));
		Возврат JsonОтвет(Данные);
	Исключение
		Возврат ОтветОшибки(500, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция SpravochniklarGET(ВходящийЗапрос)
	Попытка
		З = Новый Запрос;
		З.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Организация КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Код КАК Код,
		|	Т.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Филиал КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Наименование КАК Наименование,
		|	ПРЕДСТАВЛЕНИЕ(Т.ТипГруппаОС) КАК Тип
		|ИЗ
		|	Справочник.ГруппаОС КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Наименование КАК Наименование,
		|	Т.Филиал КАК Филиал,
		|	Т.Телефон КАК Телефон,
		|	Т.ИшданБушатилган КАК ИшданБушатилган,
		|	Т.НеАктив КАК НеАктив,
		|	Т.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Ходимлар КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Наименование";
		Пакет = З.ВыполнитьПакет();

		Ташкилотлар = Новый Массив;
		Выб = Пакет[0].Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("ref", Ид(Выб.Ссылка));
			Э.Вставить("nomi", Стр(Выб.Наименование));
			Ташкилотлар.Добавить(Э);
		КонецЦикла;

		Филиаллар = Новый Массив;
		Выб = Пакет[1].Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("ref", Ид(Выб.Ссылка));
			Э.Вставить("kod", СокрЛП(Стр(Выб.Код)));
			Э.Вставить("nomi", Стр(Выб.Наименование));
			Филиаллар.Добавить(Э);
		КонецЦикла;

		Турлар = Новый Массив;
		Выб = Пакет[2].Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("ref", Ид(Выб.Ссылка));
			Э.Вставить("nomi", Стр(Выб.Наименование));
			Э.Вставить("tip", Стр(Выб.Тип));
			Турлар.Добавить(Э);
		КонецЦикла;

		Ходимлар = Новый Массив;
		Выб = Пакет[3].Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("ref", Ид(Выб.Ссылка));
			Э.Вставить("ism", Стр(Выб.Наименование));
			Э.Вставить("filial", Ид(Выб.Филиал));
			Э.Вставить("telefon", Стр(Выб.Телефон));
			Э.Вставить("ishdan_bushagan", Бул(Выб.ИшданБушатилган));
			Э.Вставить("neaktiv", Бул(Выб.НеАктив));
			Э.Вставить("ochirilgan", Бул(Выб.ПометкаУдаления));
			Ходимлар.Добавить(Э);
		КонецЦикла;

		Данные = Новый Структура;
		Данные.Вставить("tashkilotlar", Ташкилотлар);
		Данные.Вставить("filiallar", Филиаллар);
		Данные.Вставить("av_turlari", Турлар);
		Данные.Вставить("xodimlar", Ходимлар);
		Возврат JsonОтвет(Данные);
	Исключение
		Возврат ОтветОшибки(500, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция VositalarGET(ВходящийЗапрос)
	Попытка
		З = Новый Запрос;
		З.Текст =
		"ВЫБРАТЬ
		|	ОС.Ссылка КАК Ссылка,
		|	ОС.Код КАК Код,
		|	ОС.Наименование КАК Наименование,
		|	ОС.НаименованиеПолное КАК НаименованиеПолное,
		|	ОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОС.ДатаВыпуска КАК ДатаВыпуска,
		|	ОС.ГруппаОС КАК ГруппаОС,
		|	ОС.Организация КАК Организация,
		|	ОС.Филиал КАК Филиал,
		|	ОС.Комментарий КАК Комментарий,
		|	ОС.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОС
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОС.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	О.ОсновныеСредства КАК ОсновноеСредство,
		|	О.Организация КАК Организация,
		|	О.Филиал КАК Филиал,
		|	СУММА(ЕСТЬNULL(О.КоличествоОстаток, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(О.СуммаОстаток, 0)) КАК Сумма
		|ИЗ
		|	РегистрНакопления.УчетОС.Остатки() КАК О
		|
		|СГРУППИРОВАТЬ ПО
		|	О.ОсновныеСредства,
		|	О.Организация,
		|	О.Филиал
		|
		|ИМЕЮЩИЕ
		|	(СУММА(ЕСТЬNULL(О.КоличествоОстаток, 0)) <> 0
		|		ИЛИ СУММА(ЕСТЬNULL(О.СуммаОстаток, 0)) <> 0)";
		Пакет = З.ВыполнитьПакет();

		Воситалар = Новый Массив;
		Выб = Пакет[0].Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("ref", Ид(Выб.Ссылка));
			Э.Вставить("kod", СокрЛП(Стр(Выб.Код)));
			Э.Вставить("nomi", Стр(Выб.Наименование));
			Э.Вставить("toliq_nomi", Стр(Выб.НаименованиеПолное));
			Э.Вставить("inv_raqam", СокрЛП(Стр(Выб.ИнвентарныйНомер)));
			Э.Вставить("chiqarilgan_sana", ДатаISO(Выб.ДатаВыпуска));
			Э.Вставить("turi", Ид(Выб.ГруппаОС));
			Э.Вставить("tashkilot", Ид(Выб.Организация));
			Э.Вставить("filial", Ид(Выб.Филиал));
			Э.Вставить("izoh", Стр(Выб.Комментарий));
			Э.Вставить("ochirilgan", Бул(Выб.ПометкаУдаления));
			Воситалар.Добавить(Э);
		КонецЦикла;

		Колдиклар = Новый Массив;
		Выб = Пакет[1].Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("av", Ид(Выб.ОсновноеСредство));
			Э.Вставить("tashkilot", Ид(Выб.Организация));
			Э.Вставить("filial", Ид(Выб.Филиал));
			Э.Вставить("soni", Сон(Выб.Количество));
			Э.Вставить("summa", Сон(Выб.Сумма));
			Колдиклар.Добавить(Э);
		КонецЦикла;

		Данные = Новый Структура;
		Данные.Вставить("vositalar", Воситалар);
		Данные.Вставить("qoldiqlar", Колдиклар);
		Возврат JsonОтвет(Данные);
	Исключение
		Возврат ОтветОшибки(500, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция HarakatlarGET(ВходящийЗапрос)
	Попытка
		ДанСтрока = ВходящийЗапрос.ПараметрыЗапроса.Получить("dan");
		ГачаСтрока = ВходящийЗапрос.ПараметрыЗапроса.Получить("gacha");
		Если ДанСтрока = Неопределено ИЛИ ГачаСтрока = Неопределено Тогда
			Возврат ОтветОшибки(400, "dan va gacha parametrlari majburiy (format: YYYYMMDDhhmmss)");
		КонецЕсли;
		Дан = РазобратьДату(ДанСтрока);
		Если Дан = Неопределено Тогда
			Возврат ОтветОшибки(400, "dan parametri noto'g'ri: '" + ДанСтрока + "' (format: YYYYMMDDhhmmss)");
		КонецЕсли;
		Гача = РазобратьДату(ГачаСтрока);
		Если Гача = Неопределено Тогда
			Возврат ОтветОшибки(400, "gacha parametri noto'g'ri: '" + ГачаСтрока + "' (format: YYYYMMDDhhmmss)");
		КонецЕсли;
		Если Дан > Гача Тогда
			Возврат ОтветОшибки(400, "dan parametri gacha dan katta bo'lmasligi kerak");
		КонецЕсли;

		З = Новый Запрос;
		З.Текст =
		"ВЫБРАТЬ
		|	У.Период КАК Период,
		|	У.Регистратор КАК Регистратор,
		|	У.Регистратор.Номер КАК НомерДокумента,
		|	У.ВидДвижения КАК ВидДвижения,
		|	У.ОсновныеСредства КАК ОсновноеСредство,
		|	У.Организация КАК Организация,
		|	У.Филиал КАК Филиал,
		|	ЕСТЬNULL(У.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(У.Сумма, 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.УчетОС КАК У
		|ГДЕ
		|	У.Период МЕЖДУ &Дан И &Гача
		|	И У.Активность
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	У.НомерСтроки";
		З.УстановитьПараметр("Дан", Дан);
		З.УстановитьПараметр("Гача", Гача);

		ТурлариКэш = Новый Соответствие;
		Харакатлар = Новый Массив;
		Выб = З.Выполнить().Выбрать();
		Пока Выб.Следующий() Цикл
			Э = Новый Структура;
			Э.Вставить("sana", ДатаВремяISO(Выб.Период));
			Э.Вставить("hujjat_turi", ТурДокумента(Выб.Регистратор, ТурлариКэш));
			Э.Вставить("hujjat_raqami", НомерСтрокой(Выб.НомерДокумента));
			Э.Вставить("hujjat_ref", Ид(Выб.Регистратор));
			Э.Вставить("av", Ид(Выб.ОсновноеСредство));
			Э.Вставить("tashkilot", Ид(Выб.Организация));
			Э.Вставить("filial", Ид(Выб.Филиал));
			Если Выб.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				Э.Вставить("vid", "kirim");
			Иначе
				Э.Вставить("vid", "chiqim");
			КонецЕсли;
			Э.Вставить("soni", Сон(Выб.Количество));
			Э.Вставить("summa", Сон(Выб.Сумма));
			Харакатлар.Добавить(Э);
		КонецЦикла;

		Данные = Новый Структура;
		Данные.Вставить("harakatlar", Харакатлар);
		Возврат JsonОтвет(Данные);
	Исключение
		Возврат ОтветОшибки(500, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// ===================== YORDAMCHI =====================

Функция ВерсияСервиса()
	Возврат "1.0.0";
КонецФункции

Функция JsonОтвет(Данные, Код = 200)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибки(Код, Текст)
	Возврат JsonОтвет(Новый Структура("xato", Строка(Текст)), Код);
КонецФункции

// Ssilka -> UUID satr; bo'sh ssilka / NULL / Неопределено -> Неопределено (JSON null)
Функция Ид(Ссылка)
	Если Ссылка = Null ИЛИ Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат XMLСтрока(Ссылка);
КонецФункции

Функция Стр(Значение)
	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция Бул(Значение)
	Возврат (Значение = Истина);
КонецФункции

Функция Сон(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Sana -> "YYYY-MM-DD"; bo'sh sana -> Неопределено (JSON null)
Функция ДатаISO(Значение)
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение = Дата(1, 1, 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Лев(XMLСтрока(Значение), 10);
КонецФункции

// Sana -> "YYYY-MM-DDTHH:MM:SS"; bo'sh sana -> Неопределено (JSON null)
Функция ДатаВремяISO(Значение)
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение = Дата(1, 1, 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат XMLСтрока(Значение);
КонецФункции

// "YYYYMMDDhhmmss" -> Дата; noto'g'ri bo'lsa Неопределено
Функция РазобратьДату(Знач Значение)
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) <> 14 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Н = 1 По 14 Цикл
		Если СтрНайти("0123456789", Сред(Значение, Н, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Результат = Дата(
			Число(Сред(Значение, 1, 4)),
			Число(Сред(Значение, 5, 2)),
			Число(Сред(Значение, 7, 2)),
			Число(Сред(Значение, 9, 2)),
			Число(Сред(Значение, 11, 2)),
			Число(Сред(Значение, 13, 2)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Hujjat (registrator) metadata nomi, masalan "ПеремещениеОС"
Функция ТурДокумента(Регистратор, Кэш)
	Если Регистратор = Null ИЛИ Регистратор = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Тип = ТипЗнч(Регистратор);
	Имя = Кэш.Получить(Тип);
	Если Имя = Неопределено Тогда
		Имя = Регистратор.Метаданные().Имя;
		Кэш.Вставить(Тип, Имя);
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция НомерСтрокой(Номер)
	Если Номер = Null ИЛИ Номер = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Номер) = Тип("Число") Тогда
		Возврат Формат(Номер, "ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Номер));
КонецФункции

// Baza nomi СтрокаСоединенияИнформационнойБазы() dan: Srvr="..";Ref="TestClaude"; -> "TestClaude"
// Fayl baza: File="C:\Bazalar\KSB"; -> "KSB". Aniqlab bo'lmasa — bo'sh satr.
Функция ИмяБазы()
	Попытка
		СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Исключение
		Возврат "";
	КонецПопытки;
	Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		Поз = СтрНайти(Часть, "=");
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(СокрЛП(Лев(Часть, Поз - 1)));
		Значение = СокрЛП(СтрЗаменить(Сред(Часть, Поз + 1), """", ""));
		Если Ключ = "ref" Тогда
			Возврат Значение;
		ИначеЕсли Ключ = "file" Тогда
			Значение = СтрЗаменить(Значение, "/", "\");
			Пока СтрДлина(Значение) > 0 И Прав(Значение, 1) = "\" Цикл
				Значение = Лев(Значение, СтрДлина(Значение) - 1);
			КонецЦикла;
